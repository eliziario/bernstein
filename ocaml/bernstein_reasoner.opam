opam-version: "2.0"
synopsis: "Bernstein architecture and policy reasoner"
description: "Pure semantic reasoning for Bernstein architecture and policy declarations."
maintainer: "Bernstein maintainers"
authors: "Bernstein maintainers"
license: "GPL-3.0-only"
depends: [
  "ocaml" {>= "5.5"}
  "dune" {>= "3.24"}
  "yojson" {>= "2.2"}
  "ocamlformat" {with-dev-setup}
]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
